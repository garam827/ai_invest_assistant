GOOGLE_OAUTH_CLIENT_SECRET_PATH=client_secret.json
# Interactive OAuth consent is opt-in via scripts/authorize_drive.py.
GOOGLE_OAUTH_ALLOW_INTERACTIVE=false
# Local tools remain private; Docker always enables public snapshot-only mode.
STREAMLIT_PUBLIC_MODE=false
GOOGLE_OAUTH_TOKEN_PATH=token.json
DRIVE_FOLDER_ID=your-google-drive-folder-id

INITIAL_HISTORY_PERIOD=5y
YFINANCE_REQUEST_DELAY_SEC=0.5
# Drive worker count; Yahoo stays sequential. Set 1 to disable concurrency.
COLLECTION_WORKERS=3
COLLECTION_RETRY_ROUNDS=1
COLLECTION_RETRY_DELAY_SEC=30
YFINANCE_RATE_LIMIT_COOLDOWN_SEC=60

# LLM provider: openai (default) | openrouter. Both use the same OpenAI-compatible
# /chat/completions contract, so only the key/model below change between them.
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
# Optional overrides. LLM_MODEL_NAME defaults to gpt-5 for openai / the free nemotron model
# for openrouter; check your provider dashboard for the exact model ID you have access to.
# LLM_MODEL_NAME=gpt-5
# LLM_BASE_URL=https://api.openai.com/v1
# To fall back to the previous free-tier setup:
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=your-openrouter-api-key

# Read timeout (seconds) per /chat/completions call. 180 leaves room for the longest prompt
# (the "오늘 챙겨야 할 해외 이슈" briefing); lower it only if you'd rather drop that section than wait.
# LLM_REQUEST_TIMEOUT_SEC=180

EXA_API_KEY=your-exa-api-key
EXA_NEWS_LOOKBACK_DAYS=7

DATA_FRESHNESS_MAX_AGE_DAYS=4

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional Notion mirror. NOTION_PARENT_PAGE_ID is only used by scripts/setup_notion_db.py;
# it prints the two DB IDs below. Leave the IDs empty to disable the Notion step entirely.
NOTION_API_KEY=your-notion-integration-token
NOTION_PARENT_PAGE_ID=your-notion-parent-page-id
NOTION_REPORTS_DB_ID=
NOTION_SIGNALS_DB_ID=
